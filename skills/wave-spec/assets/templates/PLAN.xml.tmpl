<?xml version="1.0" encoding="UTF-8"?>
<!-- wave-spec PLAN — depends_on empty = ready for parallel dispatch after approve -->
<plan>
  <status>draft</status>
  <spec>./SPEC.xml</spec>
  <created>${DATE}</created>
  <slug>${SLUG}</slug>

  <meta>
    <summary></summary>
    <waves_count>1</waves_count>
  </meta>

  <!-- Program mode: use phases. Wave mode: use tasks only (single phase). -->
  <phases>
    <phase id="P0" title="Baseline &amp; access">
      <outcome></outcome>
    </phase>
  </phases>

  <tasks>
    <!-- PRIMARY idiom: attribute-style tasks (what real waves use — [client-project] I0–I7).
         One line per task; easiest for agents to scan. -->
    <task id="T01" title="" depends_on="" owner="claude-glm" stream="" artifact="research/${SLUG}/T01.md" done_when="">
      <!-- owner: orchestrator|claude-glm|opencode-flash|grok|human, or a free-text routing hint
           (e.g. "deepseek-implement + glm-review"). stream: optional domain stream id (program-maps.md). -->
      <model_hint><!-- OPTIONAL free-text routing hint, e.g. "glm-5.2 writer + codex reviewer".
           Not an enum — omit if owner already says who; never leave a bare empty tag. --></model_hint>
      <status><!-- lifecycle state, tracked authoritatively in STATUS.md:
           implement_done|in_review|commit|pr|merge|deploy_gate|on_prod|done --></status>
      <do><!-- optional: concrete steps --></do>
      <note><!-- optional --></note>
    </task>

    <task id="T02" title="" depends_on="T01" owner="claude-glm" artifact="research/${SLUG}/T02.md" done_when="" />

    <!-- FALLBACK idiom (verbose; use only when an orchestrator cannot emit attributes):
         <task id="T03">
           <title></title><depends_on></depends_on><owner>claude-glm</owner>
           <artifact>research/${SLUG}/T03.md</artifact><done_when></done_when>
         </task>
    -->
  </tasks>

  <gates>
    <gate id="G1" owner="human" when="before production / irreversible changes">
      Review artifacts and approve deploy/edits.
    </gate>
  </gates>

  <parallel_policy>
    Tasks may run in parallel only if depends_on is satisfied and artifact paths do not overlap.
  </parallel_policy>
</plan>
