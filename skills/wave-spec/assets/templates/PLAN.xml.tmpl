<?xml version="1.0" encoding="UTF-8"?>
<!-- wave-spec PLAN — depends_on empty = ready for parallel dispatch after approve -->
<plan>
  <status>draft</status>
  <spec>./SPEC.xml</spec>
  <created>${DATE}</created>
  <slug>${SLUG}</slug>

  <meta>
    <summary></summary>
    <waves_count>1</waves_count>
  </meta>

  <!-- Program mode: use phases. Wave mode: use tasks only (single phase). -->
  <phases>
    <phase id="P0" title="Baseline &amp; access">
      <outcome></outcome>
    </phase>
  </phases>

  <tasks>
    <!-- PRIMARY idiom: attribute-style tasks (what real waves use — successive iterations I0–I7).
         One line per task; easiest for agents to scan. -->
    <task id="T01" title="" depends_on="" owner="writer" stream="" artifact="research/${SLUG}/T01.md" done_when="">
      <!-- owner: reference a role id from <roles> below (e.g. "writer", "reviewer"),
           or orchestrator|human for non-model tasks. -->
      <!-- done_when: исполняемая команда (grep/test/curl) или проверяемый факт;
           проза — только если команды нет. -->
      <status><!-- lifecycle state, tracked authoritatively in STATUS.md:
           implement_done|in_review|commit|pr|merge|deploy_gate|on_prod|done --></status>
      <do><!-- optional: concrete steps --></do>
      <note><!-- optional --></note>
    </task>

    <task id="T02" title="" depends_on="T01" owner="reviewer" artifact="research/${SLUG}/T02.md" done_when="" />
  </tasks>

  <roles>
    <!-- Default stack: Flash orchestrator + primary writer · Qwen reviewer/architect · GLM multi-file writer + 2nd-line reviewer · GPT-5.5 security gate -->
    <orchestrator tool="opencode" agent="A/agent1st_v37.3-flash" family="DeepSeek">
      deepseek-v4-flash
    </orchestrator>
    <executors>
      <executor id="writer" tool="opencode" agent="A/agent1st_v37.3-flash" family="DeepSeek">
        DeepSeek V4 Flash — primary writer/coder (single-file, bulk code, tests); fast + cheap, strong on 0731 benchmarks
      </executor>
      <executor id="writer-multifile" tool="opencode" agent="A/agent1st_glm" family="Zhipu" optional="true">
        GLM 5.2 — multi-file writer (3+ файлов; 1M state continuity); second-line reviewer
      </executor>
      <executor id="reviewer" tool="opencode" agent="A/agent1st_qwen-3.8" family="Alibaba">
        Qwen 3.8 Max — reviewer / архитектор / бизнес-аналитик (default reviewer; owner empirical: сильнее GLM в architecture)
      </executor>
      <executor id="security" tool="codex" family="OpenAI" optional="true">
        GPT-5.5 — behavioral regression gate (security/RLS/fidelity ports)
      </executor>
    </executors>
    <launch_file>LAUNCH.md</launch_file>
    <family_rule>writer.family ≠ reviewer.family</family_rule>
  </roles>

  <gates>
    <gate id="G1" owner="human" when="before production / irreversible changes">
      Review artifacts and approve deploy/edits.
    </gate>
  </gates>

  <parallel_policy>
    Tasks may run in parallel only if depends_on is satisfied and artifact paths do not overlap.
  </parallel_policy>
</plan>
