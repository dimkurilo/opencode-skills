<?xml version="1.0" encoding="UTF-8"?>
<!-- wave-spec SPEC — agent-facing contract. status: draft | approved | done | cancelled -->
<spec>
  <status>draft</status>
  <kind>wave</kind><!-- program | wave | task -->
  <created>${DATE}</created>
  <slug>${SLUG}</slug>
  <title>${TITLE}</title>

  <!-- Optional review provenance — fill when the SPEC goes through multi-model review.
       Mirrors [client-project] SPEC; the lifecycle "In Review → approved" gate reads these. -->
  <version><!-- e.g. 0.3-accepted --></version>
  <review_round><!-- integer; 0 if no review --></review_round>
  <accepted_by><!-- human | orchestrator --></accepted_by>
  <accepted_at><!-- YYYY-MM-DD --></accepted_at>
  <review_sources>
    <file><!-- waves/<slug>/reviews/<reviewer>-roundN.md --></file>
  </review_sources>

  <goal>
    <summary><!-- 1-2 paragraphs --></summary>
    <success_criteria>
      <criterion id="S1" measurable="true"><!-- checkable outcome --></criterion>
      <criterion id="S2" measurable="true"></criterion>
    </success_criteria>
  </goal>

  <scope>
    <in>
      <item></item>
    </in>
    <out>
      <item></item>
    </out>
  </scope>

  <constraints>
    <constraint id="C-deploy">No production deploy without human gate.</constraint>
    <constraint id="C-evidence">No invented metrics; every number needs source.</constraint>
    <constraint id="C-stack"><!-- e.g. React + Node.js // Python + FastAPI — repo/platform/language pair --></constraint>
  </constraints>

  <assumptions>
    <!-- Mark assumptions made when the user said "use defaults / решай сам".
         Each assumption = a decision the user did NOT make explicitly. See ASSUMPTIONS.md.tmpl. -->
    <assumption id="AS1" decision="default"><!-- what was assumed + why --></assumption>
  </assumptions>

  <sources>
    <!-- path or URL + date; do not invent -->
    <source type="file" path="" as_of=""></source>
  </sources>

  <!-- Domain-specific workstreams. Pick from references/program-maps.md for your domain.
       List only relevant streams; do NOT copy all. Omit for small waves.
       Example ids are domain-specific — see program-maps §1–§4
       Example (fidelity port): inventory | parity | scaffolding | core | api | ux
       Example (translation): glossary | draft | literary | qa | typeset
  -->
  <workstreams>
    <stream id="example"><!-- domain-specific, from program-maps --></stream>
  </workstreams>

  <risks>
    <risk id="R1" severity="high">
      <description></description>
      <mitigation></mitigation>
    </risk>
  </risks>

  <acceptance>
    <check id="A1"></check>
  </acceptance>

  <roles>
    <orchestrator family="xAI">grok-4.5</orchestrator>
    <executors>
      <executor id="writer" tool="qwen" flags="--approval-mode yolo" effort="/effort medium" family="Alibaba">
        Primary coder
      </executor>
      <executor id="reviewer" tool="opencode" agent="A/agent1st_v36-pro" family="DeepSeek">
        Reviewer (cross-family with writer)
      </executor>
      <executor id="glm" tool="opencode" agent="A/agent1st_v13-glm" family="Zhipu" optional="true">
        Optional reviewer / multi-file writer (availability per model-card.md)
      </executor>
    </executors>
    <launch_file>LAUNCH.md</launch_file>
    <family_rule>writer.family ≠ reviewer.family</family_rule>
  </roles>

  <todos>
    <!-- unknown facts — never invent -->
    <todo id="TBD1"></todo>
  </todos>
</spec>
